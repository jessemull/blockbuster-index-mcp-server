{
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1104.0",
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/lib-dynamodb": "^3.1104.0",
    "axios": "^1.19.0",
    "bunyan": "^1.8.15",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "puppeteer": "^24.43.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bunyan": "^1.8.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "aws-sdk-client-mock": "^4.1.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-merge": "^6.0.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.tsx": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": "prettier --write",
    "*.css": "prettier --write",
    "*.md": "prettier --write"
  },
  "main": "dist/index.js",
  "name": "blockbuster-index-mcp-server",
  "scripts": {
    "bastion": "node ./scripts/connect.js",
    "build": "webpack --config webpack.config.js",
    "clean": "rm -rf dist",
    "commit": "git-cz",
    "coverage:open": "open ./coverage/lcov-report/index.html",
    "ecs:run": "node scripts/run-ecs-task.js",
    "ecs:run:all": "node scripts/run-all-ecs-tasks.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "npm run clean",
    "prepare": "husky",
    "signal": "node scripts/run-signal.js",
    "signal:container": "sh scripts/run-signal-container.sh",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "version": "1.0.0"
}
